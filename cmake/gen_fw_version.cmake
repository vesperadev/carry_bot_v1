# Generate fw_version.h from git (branch + short hash + subject).
# Invoked as: cmake -DSOURCE_DIR=... -DOUT_H=... -P gen_fw_version.cmake

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUT_H)
  message(FATAL_ERROR "SOURCE_DIR and OUT_H required")
endif()

function(fw_git outvar)
  execute_process(
    COMMAND git ${ARGN}
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE _v
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    set(_v "unknown")
  endif()
  set(${outvar} "${_v}" PARENT_SCOPE)
endfunction()

fw_git(FW_BRANCH rev-parse --abbrev-ref HEAD)
fw_git(FW_HASH rev-parse --short=7 HEAD)
fw_git(FW_DESC log -1 --pretty=%s)

# Escape for C string literals
function(fw_c_escape invar outvar)
  set(_s "${${invar}}")
  string(REPLACE "\\" "\\\\" _s "${_s}")
  string(REPLACE "\"" "\\\"" _s "${_s}")
  string(REPLACE "\n" " " _s "${_s}")
  string(REPLACE "\r" "" _s "${_s}")
  set(${outvar} "${_s}" PARENT_SCOPE)
endfunction()

fw_c_escape(FW_BRANCH FW_BRANCH_C)
fw_c_escape(FW_HASH FW_HASH_C)
fw_c_escape(FW_DESC FW_DESC_C)

get_filename_component(_outdir "${OUT_H}" DIRECTORY)
file(MAKE_DIRECTORY "${_outdir}")

file(WRITE "${OUT_H}" "/* Auto-generated by cmake/gen_fw_version.cmake — do not edit */
#ifndef FW_VERSION_H
#define FW_VERSION_H

#define FW_VERSION_BRANCH \"${FW_BRANCH_C}\"
#define FW_VERSION_HASH   \"${FW_HASH_C}\"
#define FW_VERSION_DESC   \"${FW_DESC_C}\"

#endif /* FW_VERSION_H */
")

message(STATUS "fw_version: ${FW_BRANCH} ${FW_HASH} — ${FW_DESC}")
